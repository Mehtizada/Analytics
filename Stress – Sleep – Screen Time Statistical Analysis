      "source": [
        "# STRESS – SLEEP – SCREEN TIME ANALYSIS\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "np.random.seed(42)\n",
        "n = 80\n",
        "\n",
        "sleep = np.random.normal(7, 1.2, n)               # sleep time\n",
        "screen = np.random.normal(4, 1.5, n)              # screen time\n",
        "stress = 3*screen - 2*sleep + np.random.normal(0, 2, n)  # stress score"
      ],
      "metadata": {
        "id": "PGrgamQ3gYvW"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "df = pd.DataFrame({\n",
        "    'sleep_hours': sleep,\n",
        "    'screen_time': screen,\n",
        "    'stress_score': stress})"
      ],
      "metadata": {
        "id": "Fi4orIY-grMY"
      },
      "execution_count": 6,
      "outputs": []
